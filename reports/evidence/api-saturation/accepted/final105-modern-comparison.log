OAI.KLInvariance.MomentGraph.splitVertex.eq_1.{um} {V : Type um} (x : V) :
  splitVertex x =
    { toFun := fun y => if h : y = x then ⊥ else ↑⟨y, h⟩, invFun := fun n => WithBot.recBotCoe x Subtype.val n,
      left_inv := ⋯, right_inv := ⋯ }
OAI.KLInvariance.MomentGraph.splitEdge.eq_1.{um} {V E : Type um} [PartialOrder V] (G : OrderedGraph V E) (x : V) :
  splitEdge G x =
    { toFun := fun e => if h : G.source e = x then Sum.inr ⟨e, h⟩ else Sum.inl ⟨e, h⟩,
      invFun := Sum.elim Subtype.val Subtype.val, left_inv := ⋯, right_inv := ⋯ }
