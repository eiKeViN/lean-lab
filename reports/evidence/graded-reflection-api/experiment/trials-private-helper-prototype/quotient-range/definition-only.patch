+private theorem rangeViaQuotient_val (e : Hom M M) (f : Hom N N) (g : Hom M N)
+    (h : ∀ m, f.map (g.map m)=g.map (e.map m)) (v : range e) :
+    (rangeViaQuotient e f g h v).val = g.map v.val := by
+  rcases v with ⟨_,m,rfl⟩
+  simp only [rangeViaQuotient, LinearMap.comp_apply,
+    LinearMap.quotKerEquivRange_symm_apply_image, Submodule.liftQ_apply]
+  exact h m
