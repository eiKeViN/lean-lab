+private noncomputable def rangeViaQuotient (e : Hom M M) (f : Hom N N) (g : Hom M N)
+    (h : ∀ m, f.map (g.map m)=g.map (e.map m)) : range e →ₗ[A] range f :=
+  ((LinearMap.ker e.map).liftQ (f.map.rangeRestrict.comp g.map) (by
+    intro m hm
+    apply Subtype.ext
+    exact (h m).trans ((congrArg g.map (LinearMap.mem_ker.mp hm)).trans (map_zero g.map)))).comp
+      e.map.quotKerEquivRange.symm.toLinearMap
