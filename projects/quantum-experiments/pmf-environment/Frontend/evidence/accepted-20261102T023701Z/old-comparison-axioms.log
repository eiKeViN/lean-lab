'QuantumExperiments.PMFComparison.Finite.variance_add' depends on axioms: [propext, Classical.choice, Quot.sound]
QuantumExperiments.PMFComparison.Finite.variance_add.{u_1} {α : Type u_1} [Fintype α] (d : ProbDistribution α)
  (f g : α → ℝ) :
  (QuantumExperiments.PMFComparison.Finite.variance d fun a => f a + g a) =
    QuantumExperiments.PMFComparison.Finite.variance d f + QuantumExperiments.PMFComparison.Finite.variance d g +
      2 * QuantumExperiments.PMFComparison.Finite.covariance d f g
