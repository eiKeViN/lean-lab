  (c : ℝ) (f : α → ℝ),
  (QuantumExperiments.PMFComparison.Finite.variance d fun a => c * f a) =
    c ^ 2 * QuantumExperiments.PMFComparison.Finite.variance d f
'QuantumExperiments.FiniteProbability.variance_scale' depends on axioms: [propext, Classical.choice, Quot.sound]
@QuantumExperiments.FiniteProbability.weighted_variance : ∀ {ι : Type u_1} {O : Type u_2} [inst : Fintype ι]
  [inst_1 : Fintype O] (d : ι → ProbDistribution O) (w : ι → ℝ) (f : ι → O → ℝ),
  (QuantumExperiments.FiniteProbability.productVariance d fun os => ∑ i, w i * f i (os i)) =
    ∑ i, w i ^ 2 * QuantumExperiments.PMFComparison.Finite.variance (d i) (f i)
'QuantumExperiments.FiniteProbability.weighted_variance' depends on axioms: [propext, Classical.choice, Quot.sound]
