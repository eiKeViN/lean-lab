/-!
# Finite schedules and order-independent circuit semantics

A schedule uses exact natural-number clock ticks. `earliest` constructs a schedule by recursion
on topologically numbered events, and `earliest_le` proves its pointwise minimality. Resource
sets are independent of quantum wire support. `checkSchedule` checks every precedence and resource
constraint rather than trusting an external scheduler.

`linearExtension_prod_eq` proves that two linear extensions have the same product whenever
incomparable events commute. Products in this file follow list order; for chronological operator
composition one applies the theorem to the opposite monoid.

## References

Tao et al., *Giallar: Push-Button Verification for the Qiskit Quantum Compiler*, PLDI 2022.
The accompanying `Specification.md`, sections D2 and E1--E2, fixes the verification tasks.
-/

@[expose] public section

namespace Giallar
namespace Scheduling

/-- A list respects precedence when no later event is required before an earlier event. -/
def Respects {α : Type*} (r : α → α → Prop) (l : List α) : Prop :=
  l.Pairwise (fun a b => ¬ r b a)

/-- Reordering generated by adjacent incomparable swaps, with arbitrary unchanged prefixes. -/
inductive IndependentPerm {α : Type*} (r : α → α → Prop) : List α → List α → Prop
  /-- Leave a list unchanged. -/
  | refl (l) : IndependentPerm r l l
  /-- Keep a common first event unchanged. -/
  | cons (a) {l₁ l₂} : IndependentPerm r l₁ l₂ →
      IndependentPerm r (a :: l₁) (a :: l₂)
  /-- Swap two adjacent incomparable events. -/
  | swap (a b) (l) : ¬ r a b → ¬ r b a →
      IndependentPerm r (a :: b :: l) (b :: a :: l)
  /-- Concatenate two finite sequences of permitted swaps. -/
  | trans {l₁ l₂ l₃} : IndependentPerm r l₁ l₂ → IndependentPerm r l₂ l₃ →
      IndependentPerm r l₁ l₃

private theorem independentPerm_bubble {α : Type*} (r : α → α → Prop)
    (a : α) (u v : List α) (hc : ∀ b ∈ u, ¬ r a b ∧ ¬ r b a) :
    IndependentPerm r (u ++ a :: v) (a :: (u ++ v)) := by
  induction u with
  | nil => exact IndependentPerm.refl _
  | cons b u ih =>
    apply IndependentPerm.trans (IndependentPerm.cons b
      (ih (fun c hc' => hc c (by simp [hc']))))
    exact IndependentPerm.swap b a _ (hc b (by simp)).2 (hc b (by simp)).1

/-- Any two linear extensions are connected by finitely many adjacent incomparable swaps. -/
theorem independentPerm_of_linearExtensions {α : Type*} (r : α → α → Prop)
    (hirr : ∀ a, ¬ r a a) {l₁ l₂ : List α} (hp : l₁.Perm l₂)
    (h₁ : Respects r l₁) (h₂ : Respects r l₂) : IndependentPerm r l₁ l₂ := by
  induction l₂ generalizing l₁ with
  | nil =>
    have : l₁ = [] := List.perm_nil.mp hp
    subst l₁
    exact IndependentPerm.refl _
  | cons a l₂ ih =>
    have ha : a ∈ l₁ := hp.mem_iff.mpr (by simp)
    obtain ⟨u, v, rfl⟩ := List.append_of_mem ha
    have hs := List.pairwise_append.mp h₁
    have ht := List.pairwise_cons.mp h₂
    have hc : ∀ b ∈ u, ¬ r a b ∧ ¬ r b a := by
      intro b hb
      refine ⟨hs.2.2 b hb a (by simp), ?_⟩
      have hb' : b ∈ a :: l₂ := hp.mem_iff.mp (by simp [hb])
      rcases List.mem_cons.mp hb' with h | h
      · subst b
        exact hirr a
      · exact ht.1 b h
    have hp' : (u ++ v).Perm l₂ :=
      List.Perm.cons_inv (List.perm_middle.symm.trans hp)
    have hs' : Respects r (u ++ v) := by
      apply List.pairwise_append.mpr
      refine ⟨hs.1, (List.pairwise_cons.mp hs.2.1).2, ?_⟩
      intro b hb c hc'
      exact hs.2.2 b hb c (by simp [hc'])
    exact (independentPerm_bubble r a u v hc).trans
      (IndependentPerm.cons a (ih hp' hs' ht.2))

/-- The semantics of a list is unchanged by reordering independent events. -/
theorem linearExtension_prod_eq {α M : Type*} [Monoid M] (r : α → α → Prop)
    (hirr : ∀ a, ¬ r a a) (f : α → M)
    (hcomm : ∀ a b, ¬ r a b → ¬ r b a → Commute (f a) (f b))
    {l₁ l₂ : List α} (hp : l₁.Perm l₂) (h₁ : Respects r l₁)
    (h₂ : Respects r l₂) : (l₁.map f).prod = (l₂.map f).prod := by
  induction l₂ generalizing l₁ with
  | nil =>
    have : l₁ = [] := List.perm_nil.mp hp
    subst l₁
    rfl
  | cons a l₂ ih =>
    have ha : a ∈ l₁ := hp.mem_iff.mpr (by simp)
    obtain ⟨u, v, rfl⟩ := List.append_of_mem ha
    have hs := List.pairwise_append.mp h₁
    have ht := List.pairwise_cons.mp h₂
    have hc : ∀ b ∈ u, Commute (f b) (f a) := by
      intro b hb
      apply hcomm b a
      · have hb' : b ∈ a :: l₂ := hp.mem_iff.mp (by simp [hb])
        rcases List.mem_cons.mp hb' with h | h
        · subst b
          exact hirr a
        · exact ht.1 b h
      · exact hs.2.2 b hb a (by simp)
    have hp' : (u ++ v).Perm l₂ := by
      apply List.Perm.cons_inv (a := a)
      exact List.perm_middle.symm.trans hp
    have hs' : Respects r (u ++ v) := by
      apply List.pairwise_append.mpr
      refine ⟨hs.1, (List.pairwise_cons.mp hs.2.1).2, ?_⟩
      intro b hb c hc
      exact hs.2.2 b hb c (by simp [hc])
    have hc' : Commute (u.map f).prod (f a) :=
      Commute.list_prod_left _ _ (by
        intro x hx
        obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hx
        exact hc b hb)
    calc
      ((u ++ a :: v).map f).prod = (u.map f).prod * (f a * (v.map f).prod) := by
        simp
      _ = f a * ((u ++ v).map f).prod := by
        simpa [List.map_append, List.prod_append, mul_assoc] using
          congrArg (fun x => x * (v.map f).prod) hc'.eq
      _ = ((a :: l₂).map f).prod := by rw [ih hp' hs' ht.2]; simp

/-- The same order-independence theorem in the chronological operator convention. -/
theorem linearExtension_reverse_prod_eq {α M : Type*} [Monoid M] (r : α → α → Prop)
    (hirr : ∀ a, ¬ r a a) (f : α → M)
    (hcomm : ∀ a b, ¬ r a b → ¬ r b a → Commute (f a) (f b))
    {l₁ l₂ : List α} (hp : l₁.Perm l₂) (h₁ : Respects r l₁)
    (h₂ : Respects r l₂) : (l₁.reverse.map f).prod = (l₂.reverse.map f).prod := by
  apply linearExtension_prod_eq (fun a b => r b a) hirr f
    (fun a b hab hba => hcomm a b hba hab)
    ((List.reverse_perm _).trans (hp.trans (List.reverse_perm _).symm))
  · simpa only [Respects, List.pairwise_reverse] using h₁
  · simpa only [Respects, List.pairwise_reverse] using h₂

/-- Earliest start times in a topological numbering. Predecessors outside `0,...,n-1` are ignored,
so applications must prove that their precedence relation points from smaller to larger indices. -/
def earliest (r : ℕ → ℕ → Prop) [DecidableRel r] (duration : ℕ → ℕ) (n : ℕ) : ℕ :=
  Finset.univ.sup fun i : Fin n =>
    if r i n then earliest r duration i + duration i else 0
termination_by n

/-- Every topologically earlier dependency finishes before the computed start time. -/
theorem finish_le_earliest (r : ℕ → ℕ → Prop) [DecidableRel r]
    (duration : ℕ → ℕ) {u v : ℕ} (huv : u < v) (hr : r u v) :
    earliest r duration u + duration u ≤ earliest r duration v := by
  rw [earliest.eq_def r duration v]
  simpa [hr] using
    (Finset.le_sup (f := fun i : Fin v =>
      if r i v then earliest r duration i + duration i else 0)
      (Finset.mem_univ (⟨u, huv⟩ : Fin v)))

/-- The recursively constructed schedule is pointwise least among all feasible schedules. -/
theorem earliest_le (r : ℕ → ℕ → Prop) [DecidableRel r] (duration t : ℕ → ℕ)
    (ht : ∀ u v, r u v → t u + duration u ≤ t v) (n : ℕ) :
    earliest r duration n ≤ t n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rw [earliest, Finset.sup_le_iff]
    intro i _
    split_ifs with h
    · exact (Nat.add_le_add_right (ih i i.isLt) _).trans (ht i n h)
    · exact Nat.zero_le _

/-- Feasibility of a finite exact-tick schedule, including resource exclusion. -/
structure Feasible {n k : ℕ} (r : Fin n → Fin n → Prop)
    (duration : Fin n → ℕ) (resources : Fin n → Finset (Fin k))
    (start : Fin n → ℕ) : Prop where
  /-- Each event has positive duration. -/
  duration_pos : ∀ v, 0 < duration v
  /-- A dependency finishes before the following event starts. -/
  precedence : ∀ u v, r u v → start u + duration u ≤ start v
  /-- Distinct events sharing any exclusive resource do not overlap. -/
  exclusion : ∀ u v, u ≠ v → ¬ Disjoint (resources u) (resources v) →
    start u + duration u ≤ start v ∨ start v + duration v ≤ start u

/-- An executable certificate checker for every event pair and every exclusive resource. -/
def checkSchedule {n k : ℕ} (r : Fin n → Fin n → Prop) [DecidableRel r]
    (duration : Fin n → ℕ) (resources : Fin n → Finset (Fin k))
    (start : Fin n → ℕ) : Bool :=
  decide ((∀ v, 0 < duration v) ∧
    (∀ u v, r u v → start u + duration u ≤ start v) ∧
    (∀ u v, u ≠ v → ¬ Disjoint (resources u) (resources v) →
      start u + duration u ≤ start v ∨ start v + duration v ≤ start u))

/-- The finite checker accepts exactly feasible schedules. -/
@[simp]
theorem checkSchedule_eq_true {n k : ℕ} (r : Fin n → Fin n → Prop) [DecidableRel r]
    (duration : Fin n → ℕ) (resources : Fin n → Finset (Fin k))
    (start : Fin n → ℕ) :
    checkSchedule r duration resources start = true ↔ Feasible r duration resources start := by
  simp only [checkSchedule, decide_eq_true_eq]
  exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩,
    fun h => ⟨h.duration_pos, h.precedence, h.exclusion⟩⟩

/-- Resource ordering reduces the exclusion proof to the precedence proof. -/
theorem feasible_of_ordered_resources {n k : ℕ} (r : Fin n → Fin n → Prop)
    (duration : Fin n → ℕ) (resources : Fin n → Finset (Fin k))
    (start : Fin n → ℕ) (hd : ∀ v, 0 < duration v)
    (hp : ∀ u v, r u v → start u + duration u ≤ start v)
    (hr : ∀ u v, u ≠ v → ¬ Disjoint (resources u) (resources v) → r u v ∨ r v u) :
    Feasible r duration resources start where
  duration_pos := hd
  precedence := hp
  exclusion u v huv huv' := (hr u v huv huv').imp (hp u v) (hp v u)

/-- Makespan is the latest finishing time; an empty event set has makespan zero. -/
def makespan {n : ℕ} (duration start : Fin n → ℕ) : ℕ :=
  Finset.univ.sup fun v => start v + duration v

/-- Pointwise earlier starts imply no greater makespan. -/
theorem makespan_mono {n : ℕ} (duration s t : Fin n → ℕ) (h : ∀ v, s v ≤ t v) :
    makespan duration s ≤ makespan duration t := by
  apply Finset.sup_le_iff.mpr
  intro v hv
  exact (Nat.add_le_add_right (h v) _).trans
    (Finset.le_sup (f := fun w => t w + duration w) hv)

end Scheduling
end Giallar

namespace Giallar.Scheduling

/-- Minimality needs feasibility only at indices that can contribute to the desired bound. -/
theorem earliest_le_on (r : ℕ → ℕ → Prop) [DecidableRel r] (duration t : ℕ → ℕ)
    (N : ℕ) (ht : ∀ u v, u < v → v < N → r u v → t u + duration u ≤ t v)
    {n : ℕ} (hn : n < N) : earliest r duration n ≤ t n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rw [earliest, Finset.sup_le_iff]
    intro i _
    split_ifs with h
    · exact (Nat.add_le_add_right (ih i i.isLt (i.isLt.trans hn)) _).trans
        (ht i n i.isLt hn h)
    · exact Nat.zero_le _

/-- The earliest construction is resource-feasible whenever resource users are already ordered. -/
theorem earliest_feasible {n k : ℕ} (r : ℕ → ℕ → Prop) [DecidableRel r]
    (duration : ℕ → ℕ) (resources : Fin n → Finset (Fin k))
    (hd : ∀ v : Fin n, 0 < duration v)
    (ho : ∀ u v : Fin n, r u v → u.val < v.val)
    (hr : ∀ u v : Fin n, u ≠ v → ¬ Disjoint (resources u) (resources v) →
      r u v ∨ r v u) :
    Feasible (fun u v : Fin n => r u v) (fun v => duration v) resources
      (fun v => earliest r duration v) := by
  apply feasible_of_ordered_resources _ _ _ _ hd _ hr
  intro u v h
  exact finish_le_earliest r duration (ho u v h) h

end Giallar.Scheduling
