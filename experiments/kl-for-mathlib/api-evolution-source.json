          "start": 2508,
          "old": "",
          "new": "/-- Graded coefficient transport evaluates through the original homomorphism. -/\n @[simp] theorem val_changeHom {M N : ModuleData.{uk,ua,um} \ud835\udcd0} (f : Hom M N)\n     (m : change e he M) : (changeHom e he f |>.map m).val = f.map m.val := by\n   exact CoefficientChange.val_map e f.map m\n\n "
        }
      ]
    },
